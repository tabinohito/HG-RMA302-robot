+        ntc_trip_raw>=1000 && ntc_trip_raw<=3200 &&
+        wheel_cycles_milli>=1000 && wheel_cycles_milli<=1000000 &&
+        min_mrpm>=8000 && min_mrpm<=max_mrpm && max_mrpm<=25000 &&
+        max_iq_ma>=100 && max_iq_ma<=2000 && max_iq_ma*2<=phase_trip_ma &&
