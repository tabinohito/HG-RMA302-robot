+    { InterruptLock lock; active_config_id=0; armed=protection_ready=false; }
+    printf("config_begin=%lu\r\n",static_cast<unsigned long>(value)); return true;
+  }
+  if (!strncmp(line,"cfgset ",7)) {
+    char* key=line+7; char* space=strchr(key,' ');
+    if (space) {
+      *space='\0';
+      if (parse_uint(space+1,value) && settings_transaction.put(key,value)) {
+        printf("config_set=%s value=%lu\r\n",key,static_cast<unsigned long>(value)); return true;
+      }
+    }
+  } else if (!strncmp(line,"cfgapply ",9) && parse_uint(line+9,value) && settings_transaction.ready(value)) {
+    {
