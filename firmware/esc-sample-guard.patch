--- /dev/null
+++ b/Core/Inc/current_sum_guard.hpp
@@ -0,0 +1,45 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+
+namespace motor {
+
+// Monitor three-shunt consistency separately from the instantaneous per-phase
+// overcurrent and ADC-validity checks. At 20 kHz, ten samples span 0.5 ms.
+struct CurrentSumGuard {
+  static constexpr float soft_limit_a = 1.2f;
+  static constexpr float hard_limit_a = 2.0f;
+  static constexpr unsigned trip_samples = 10;
+  enum class Issue { none, sustained, excessive, nonfinite };
+  float sum_a = 0, peak_a = 0;
+  unsigned consecutive = 0, peak_consecutive = 0;
+
+  void reset() { *this = {}; }
+
+  Issue step(float u, float v, float w) {
+    sum_a = u + v + w;
+    if (!std::isfinite(sum_a)) return Issue::nonfinite;
+    const float magnitude = std::abs(sum_a);
+    peak_a = std::max(peak_a, magnitude);
+    if (magnitude > hard_limit_a) return Issue::excessive;
+    if (magnitude > soft_limit_a) {
+      if (consecutive < trip_samples) ++consecutive;
+    } else {
+      consecutive = 0;
+    }
+    peak_consecutive = std::max(peak_consecutive, consecutive);
+    return consecutive >= trip_samples ? Issue::sustained : Issue::none;
+  }
+
+  static const char* name(Issue issue) {
+    switch (issue) {
+      case Issue::sustained: return "current_sum_sustained";
+      case Issue::excessive: return "current_sum_hard";
+      case Issue::nonfinite: return "current_sum_nonfinite";
+      default: return "none";
+    }
+  }
+};
+
+} // namespace motor
--- /dev/null
+++ b/Core/Inc/startup_lock.hpp
@@ -0,0 +1,16 @@
+#pragma once
+#include <cstdint>
+
+namespace motor {
+// Keep 100 ms of net positive evidence at 20 kHz. One invalid observer sample
+// costs 5 valid samples, requiring >83.3% valid observations to make progress.
+// Speed/angle mismatch always resets all evidence. Runtime loss-of-lock limits
+// remain in Controller; this only qualifies the I/f -> FOC handover.
+inline constexpr uint32_t startup_lock_bad_cost = 5;
+inline constexpr uint32_t startup_lock_required_score = 2000;
+inline uint32_t startup_lock_score(uint32_t previous, bool observed, bool geometry_ok) {
+  if (!geometry_ok) return 0;
+  if (observed) return previous < startup_lock_required_score ? previous + 1 : startup_lock_required_score;
+  return previous > startup_lock_bad_cost ? previous - startup_lock_bad_cost : 0;
+}
+}
--- /dev/null
+++ b/Core/Inc/sensorless_speed_guard.hpp
@@ -0,0 +1,16 @@
+#pragma once
+#include <cmath>
+
+namespace motor {
+// The PLL's proportional term produces instantaneous speed spikes at low BEMF.
+// Speed mode uses its existing 30 ms feedback filter for the 1.5x speed limit.
+// A gross 3x raw estimate still trips immediately; legacy modes stay at 1.5x raw.
+inline const char* speed_guard(float raw_omega, float feedback_omega,
+                               float ceiling, bool speed_mode) {
+  if (!std::isfinite(raw_omega) || !std::isfinite(ceiling) || ceiling <= 0 ||
+      (speed_mode && !std::isfinite(feedback_omega))) return "speed_invalid";
+  if (std::abs(raw_omega) > (speed_mode ? 3.f : 1.5f)*ceiling) return "speed_gross";
+  if (speed_mode && std::abs(feedback_omega) > 1.5f*ceiling) return "overspeed";
+  return nullptr;
+}
+}
